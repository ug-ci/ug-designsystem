        "steps": 0
      }
    },
    "border": {
      "radius": false,
      "color": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "sm",
          "name": "Small",
          "shadow": "0 2px 2px rgba(0,0,0,.15)"
        },
        {
          "slug": "md",
          "name": "Medium",
          "shadow": "0 4px 16px rgba(0,33,77,.08)"
        },
        {
          "slug": "infobox",
          "name": "Info box",
          "shadow": "0 8px 24px rgba(0,33,77,.14)"
        },
        {
          "slug": "img",
          "name": "Image",
          "shadow": "0 1px 3px rgba(0,33,77,.12)"
        },
        {
          "slug": "card",
          "name": "User card",
          "shadow": "0 4px 10px rgba(0,0,0,.25)"
        }
      ]
    },
    "custom": {
      "radius": "0",
      "transition": ".15s",
      "arrow": {
        "width": "42px",
        "height": "11px"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--dm-sans)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.5",
      "fontWeight": "400"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--blue)"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--blue-dark)"
          },
          "typography": {
            "textDecoration": "underline"
          }
        },
        ":focus": {
          "typography": {
            "textDecoration": "underline"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--blue-dark)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--work-sans)",
          "fontWeight": "600"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--heading-1)",
          "fontWeight": "600",
          "lineHeight": "1"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--heading-2)",
          "fontWeight": "600",
          "lineHeight": "1"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--heading-3)",
          "fontWeight": "600",
          "lineHeight": "1.1"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--heading-4)",
          "fontWeight": "600",
          "lineHeight": "1.1"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--lead)",
          "fontWeight": "600",
          "lineHeight": "1.2"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--lead)",
          "fontWeight": "600",
          "lineHeight": "1.2"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--blue)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "radius": "0"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--dm-sans)",
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontWeight": "600",
          "textTransform": "uppercase",
          "letterSpacing": "1px",
          "lineHeight": "1"
        },
        "spacing": {
          "padding": {
            "top": "15px",
            "right": "25px",
            "bottom": "15px",
            "left": "20px"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--blue-dark)",
            "text": "var(--wp--preset--color--white)"
          }
        },
        ":focus": {
          "color": {
            "background": "var(--wp--preset--color--blue-dark)",
            "text": "var(--wp--preset--color--white)"
          }
        }
      },
      "caption": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        },
        "color": {
          "text": "var(--wp--preset--color--gray-text)"
        }
      }
    },
    "blocks": {
      "core/image": {
        "border": {
          "radius": "0"
        },
        "shadow": "var(--wp--preset--shadow--img)"
      },
      "core/post-featured-image": {
        "border": {
          "radius": "0"
        },
        "shadow": "var(--wp--preset--shadow--img)"
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--gray-200)"
        }
      },
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--dm-sans)",
          "fontSize": "var(--wp--preset--font-size--ui)"
        }
      },
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--work-sans)",
          "fontWeight": "600"
        }
      },
      "core/search": {
        "border": {
          "radius": "0"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Nagłówek UG",
      "area": "header"
    },
    {
      "name": "header-campaign",
      "title": "Nagłówek kampanijny (logo | pionowa linia | tytuł)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Stopka UG",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-campaign",
      "title": "Strona kampanii (nagłówek z tytułem)",
      "postTypes": [
        "page"
      ]
    }
  ]
}