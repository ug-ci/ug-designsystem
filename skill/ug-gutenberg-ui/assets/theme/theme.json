          "size": "28px",
          "fluid": false
        },
        {
          "slug": "heading-1",
          "name": "H1 64",
          "size": "64px",
          "fluid": {
            "min": "40px",
            "max": "64px"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "%",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "4",
          "name": "4px",
          "size": "4px"
        },
        {
          "slug": "8",
          "name": "8px",
          "size": "8px"
        },
        {
          "slug": "12",
          "name": "12px",
          "size": "12px"
        },
        {
          "slug": "16",
          "name": "16px",
          "size": "16px"
        },
        {
          "slug": "20",
          "name": "20px",
          "size": "20px"
        },
        {
          "slug": "24",
          "name": "24px",
          "size": "24px"
        },
        {
          "slug": "32",
          "name": "32px",
          "size": "32px"
        },
        {
          "slug": "40",
          "name": "40px",
